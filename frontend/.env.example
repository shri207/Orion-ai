# Frontend environment variables
# Copy this file to .env.local for local development.
# Set these as Environment Variables in your Vercel project settings.

# Full URL of the Railway backend (no trailing slash).
# Leave empty in local dev — the Vite dev proxy handles /api routing.
VITE_API_URL=https://your-railway-app.railway.app

# API key for backend access (must match one of the backend's API_KEYS values)
VITE_API_KEY=your-production-api-key
