PORT=5000
NODE_ENV=production
APP_NAME=AI Interview Agent
LOG_LEVEL=info

# --- Database (auto-injected by Railway PostgreSQL plugin) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/interview_agent

# --- Redis (auto-injected by Railway Redis plugin) ---
REDIS_URL=redis://localhost:6379
INTERVIEW_STATE_TTL_SECONDS=86400

# --- AI Provider ---
OPENROUTER_API_KEY=sk-or-v1-...

# --- Auth (generate strong secrets for production!) ---
JWT_SECRET=change-me-to-a-strong-secret-minimum-32-chars
JWT_EXPIRES_IN=2h

# --- API Access Keys (comma-separated) ---
API_KEYS=your-production-api-key

# --- CORS: set to your Vercel frontend URL ---
ALLOWED_ORIGINS=https://your-app.vercel.app
